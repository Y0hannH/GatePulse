{
  "name": "gatepulse",
  "displayName": "GatePulse — SQL via Fabric Pipeline",
  "description": "Run ad hoc SQL from VS Code on any Microsoft Fabric-authorized connection — gateway (on-prem / IP-filtered) or cloud — through a generic Fabric pipeline, driven only by the Fabric REST API.",
  "version": "1.0.0",
  "publisher": "gatepulse",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Y0hannH/GatePulse.git"
  },
  "bugs": {
    "url": "https://github.com/Y0hannH/GatePulse/issues"
  },
  "homepage": "https://github.com/Y0hannH/GatePulse#readme",
  "keywords": [
    "microsoft fabric",
    "fabric",
    "sql",
    "sql server",
    "data pipeline",
    "gateway",
    "data engineering",
    "azure",
    "t-sql"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gatepulse-sidebar",
          "title": "GatePulse",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "gatepulse-sidebar": [
        {
          "id": "gatepulse.tenantsView",
          "name": "Tenants",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "gatepulse.tenantsView",
        "contents": "No tenant configured.\n\n[$(add) Add a tenant](command:gatepulse.addTenant)\n\nA tenant groups the Entra ID tenant ID and the Fabric workspace where the generic SQL pipeline is provisioned automatically on first run.\n\n[$(book) Read the guide](command:gatepulse.openGuide)"
      }
    ],
    "commands": [
      {
        "command": "gatepulse.openPanel",
        "title": "GatePulse: Open SQL Panel",
        "icon": "$(play)"
      },
      {
        "command": "gatepulse.openTenant",
        "title": "GatePulse: Open Tenant"
      },
      {
        "command": "gatepulse.selectTop100",
        "title": "GatePulse: Select Top 100 Rows"
      },
      {
        "command": "gatepulse.refreshSchemaTree",
        "title": "GatePulse: Refresh Schema Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "gatepulse.signOut",
        "title": "GatePulse: Sign Out",
        "icon": "$(sign-out)"
      },
      {
        "command": "gatepulse.showLogs",
        "title": "GatePulse: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "gatepulse.switchTenant",
        "title": "GatePulse: Switch Tenant"
      },
      {
        "command": "gatepulse.addTenant",
        "title": "GatePulse: Add Tenant",
        "icon": "$(add)"
      },
      {
        "command": "gatepulse.pickConnection",
        "title": "GatePulse: Pick Connection",
        "icon": "$(plug)"
      },
      {
        "command": "gatepulse.pickPipelineOverride",
        "title": "GatePulse: Pick Pipeline (Override)",
        "icon": "$(gear)"
      },
      {
        "command": "gatepulse.refreshConnections",
        "title": "GatePulse: Refresh Connections",
        "icon": "$(refresh)"
      },
      {
        "command": "gatepulse.addDatabase",
        "title": "GatePulse: Add Database to Tenant",
        "icon": "$(add)"
      },
      {
        "command": "gatepulse.removeDatabase",
        "title": "GatePulse: Remove Manually Added Database",
        "icon": "$(trash)"
      },
      {
        "command": "gatepulse.addConnection",
        "title": "GatePulse: Add Connection to Tenant",
        "icon": "$(add)"
      },
      {
        "command": "gatepulse.removeConnection",
        "title": "GatePulse: Remove Connection From Tenant",
        "icon": "$(trash)"
      },
      {
        "command": "gatepulse.openGuide",
        "title": "GatePulse: Open Documentation",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gatepulse.openTenant",
          "when": "false"
        },
        {
          "command": "gatepulse.selectTop100",
          "when": "false"
        },
        {
          "command": "gatepulse.removeDatabase",
          "when": "false"
        },
        {
          "command": "gatepulse.removeConnection",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gatepulse.openPanel",
          "when": "view == gatepulse.tenantsView",
          "group": "navigation@1"
        },
        {
          "command": "gatepulse.addTenant",
          "when": "view == gatepulse.tenantsView",
          "group": "navigation@2"
        },
        {
          "command": "gatepulse.pickConnection",
          "when": "view == gatepulse.tenantsView",
          "group": "navigation@3"
        },
        {
          "command": "gatepulse.refreshSchemaTree",
          "when": "view == gatepulse.tenantsView",
          "group": "navigation@4"
        },
        {
          "command": "gatepulse.pickPipelineOverride",
          "when": "view == gatepulse.tenantsView",
          "group": "9_more@1"
        },
        {
          "command": "gatepulse.showLogs",
          "when": "view == gatepulse.tenantsView",
          "group": "9_more@2"
        },
        {
          "command": "gatepulse.signOut",
          "when": "view == gatepulse.tenantsView",
          "group": "9_more@3"
        },
        {
          "command": "gatepulse.openGuide",
          "when": "view == gatepulse.tenantsView",
          "group": "9_more@0"
        }
      ],
      "view/item/context": [
        {
          "command": "gatepulse.selectTop100",
          "when": "view == gatepulse.tenantsView && (viewItem == table || viewItem == view)",
          "group": "1_actions"
        },
        {
          "command": "gatepulse.removeDatabase",
          "when": "view == gatepulse.tenantsView && viewItem == database-manual",
          "group": "1_actions"
        },
        {
          "command": "gatepulse.addConnection",
          "when": "view == gatepulse.tenantsView && viewItem =~ /^tenant-/",
          "group": "inline@1"
        },
        {
          "command": "gatepulse.addDatabase",
          "when": "view == gatepulse.tenantsView && viewItem =~ /^connection/",
          "group": "inline@1"
        },
        {
          "command": "gatepulse.addConnection",
          "when": "view == gatepulse.tenantsView && viewItem =~ /^tenant-/",
          "group": "1_actions"
        },
        {
          "command": "gatepulse.addDatabase",
          "when": "view == gatepulse.tenantsView && viewItem =~ /^connection/",
          "group": "1_actions"
        },
        {
          "command": "gatepulse.removeConnection",
          "when": "view == gatepulse.tenantsView && viewItem =~ /^connection/",
          "group": "2_remove"
        }
      ]
    },
    "configuration": {
      "title": "GatePulse",
      "properties": {
        "gatepulse.tenants": {
          "type": "array",
          "default": [],
          "scope": "application",
          "description": "Tenants/workspaces available in the panel and in \"GatePulse: Switch Tenant\". No project/repo needed — GatePulse is used standalone, like the mssql extension: User Settings only (\"application\" scope) — a workspace's .vscode/settings.json cannot override this, so an untrusted repo can't silently redirect queries to a different tenant/workspace.",
          "items": {
            "type": "object",
            "required": [
              "alias",
              "tenantId",
              "workspaceId"
            ],
            "properties": {
              "alias": {
                "type": "string",
                "description": "Display name, e.g. \"Client A - Prod\"."
              },
              "tenantId": {
                "type": "string",
                "description": "Entra ID tenant GUID."
              },
              "workspaceId": {
                "type": "string",
                "description": "Fabric workspace GUID — where the generic pipeline lives, or will be auto-provisioned."
              },
              "clientId": {
                "type": "string",
                "description": "Optional: app registration override for this tenant (otherwise gatepulse.clientId)."
              },
              "pipelineId": {
                "type": "string",
                "description": "Optional: manual override, skips auto-provisioning for this tenant."
              },
              "connectionGuid": {
                "type": "string",
                "description": "Optional: Fabric SQL connection GUID pre-filled in the panel (gateway-routed or cloud)."
              },
              "databaseName": {
                "type": "string",
                "description": "Optional: database name pre-filled in the panel."
              },
              "extraDatabases": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Legacy: manual databases of the default connection. New ones are stored under connections[].extraDatabases."
              },
              "connections": {
                "type": "array",
                "description": "Optional: further connections to browse under this tenant (besides connectionGuid). Add them with the + button on the tenant row.",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Fabric connection GUID."
                    },
                    "name": {
                      "type": "string",
                      "description": "Optional display name."
                    },
                    "extraDatabases": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Databases reachable through this connection that sys.databases does not list for your login. Add them with the + button on the connection row."
                    }
                  }
                }
              }
            }
          }
        },
        "gatepulse.clientId": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional. Leave empty to sign in with Microsoft's first-party public client (same as Azure CLI / FabricPulse). Set only if you have your own app registration allowed for user sign-in. Overridden per tenant by gatepulse.tenants[].clientId. User Settings only (\"application\" scope) — a workspace can't point sign-in at an app registration of its choosing."
        },
        "gatepulse.authFlow": {
          "type": "string",
          "enum": [
            "auto",
            "azureCli",
            "interactive",
            "deviceCode"
          ],
          "default": "auto",
          "description": "auto = reuse the Azure CLI session (az login) if present, otherwise open the browser. azureCli = Azure CLI only. interactive = browser only. deviceCode = device code flow."
        },
        "gatepulse.scopes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "https://api.fabric.microsoft.com/.default"
          ],
          "scope": "application",
          "description": "Token scopes. The first-party client (empty clientId) only supports .default. User Settings only (\"application\" scope) — a workspace can't redirect the sign-in consent to a different resource."
        },
        "gatepulse.pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "description": "How often the job status is checked while a query runs (ms). Lower = results show up sooner after the job ends, at the cost of more API calls."
        },
        "gatepulse.timeoutMs": {
          "type": "number",
          "default": 120000,
          "description": "Max wait for job completion (ms). On timeout the job is cancelled."
        },
        "gatepulse.activityNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Query activities whose output is read (Lookup / Script). Empty = every Lookup and Script activity of the run."
        },
        "gatepulse.parameterPayloadFormat": {
          "type": "string",
          "enum": [
            "executionData",
            "typedParameters"
          ],
          "default": "executionData",
          "description": "How parameters are sent to the job API. executionData = {executionData:{parameters:{...}}} (pipeline format). typedParameters = {parameters:[{name,value,type}]} (generic Job Scheduler format)."
        },
        "gatepulse.parameterNames": {
          "type": "object",
          "default": {
            "connectionGuid": "connectionGuid",
            "databaseName": "databaseName",
            "query": "query"
          },
          "properties": {
            "connectionGuid": {
              "type": "string"
            },
            "databaseName": {
              "type": "string"
            },
            "query": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "description": "Parameter names as declared in the Fabric pipeline (run `inspect` to see them), e.g. {\"connectionGuid\":\"_conn\",\"databaseName\":\"_dbname\",\"query\":\"_Query\"}."
        },
        "gatepulse.logDirectory": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Folder for JSONL logs and reports (query text/metadata and sample result rows are written here). Empty = extension global storage. User Settings only (\"application\" scope) — a workspace can't redirect these logs to, say, a synced folder."
        },
        "gatepulse.cacheSchemaMetadata": {
          "type": "boolean",
          "default": true,
          "description": "Keep discovered databases/tables/views/columns (sidebar tree + editor autocomplete) cached across VS Code restarts, written to this machine's local extension storage. Turn off to keep the cache in memory only for the current session — nothing written to disk, cleared on reload. \"GatePulse: Refresh Schema Tree\" always forces a fresh fetch regardless of this setting."
        },
        "gatepulse.autoConvertUnsupportedColumns": {
          "type": "boolean",
          "default": true,
          "description": "When a query fails because a column has a type the pipeline can't transfer (binary, xml, geography, sql_variant...), re-run it once with those columns cast to text, and say so in the result. Needs one extra describe run. Turn off to get the plain error instead."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"*.js\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"*.js\"",
    "test": "tsx test/mock-selftest.ts && tsx test/provision-selftest.ts && tsx test/convert-selftest.ts",
    "vsix": "vsce package --no-dependencies",
    "cli": "node dist/cli.js",
    "validate": "node dist/cli.js all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.9.7",
    "tsx": "^4.7.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@evolve-data/pulse-core": "git+https://github.com/Y0hannH/pulse-shared.git#43ecb998eaa940a12c5a98c01081942cf38b708b"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
